<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <title>@ViewData["Title"] · Sift</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-page="/Index">Sift</a>
        <span class="local-badge">Runs on this computer · emails are never uploaded</span>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer class="site-footer">
        Parsing, storage and encryption all happen locally. Remote images in emails are never loaded.
    </footer>
</body>
</html>
